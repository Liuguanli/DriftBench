{
  "pattern_id": "trace-census-workload",
  "seed": 42,
  "trace_type": "workload",
  "data_source": {
    "kind": "csv",
    "path": "./data/census_original.csv",
    "schema_extractor": {
      "source_type": "csv",
      "sample_size": 1000,
      "schema_output_path": "./output/intermediate_yaml/census_original_schema.json"
    }
  },
  "base_table": "census_original",
  "template_defaults": {
    "num_templates": 5,
    "max_predicates": 4,
    "max_payload_columns": 4,
    "value_range": {
      "age": [17, 90],
      "hours_per_week": [1, 99]
    }
  },
  "template_runs": [
    {
      "name": "trace_sel_1",
      "output_path": "./output/intermediate_yaml/census_original_templates_trace_1.json",
      "selectivity": {
        "age": [0.1, 0.2],
        "hours_per_week": [0.1, 0.2]
      }
    }
  ],
  "query_runs": [
    {
      "name": "trace_distribution_uniform",
      "template": "trace_sel_1",
      "queries_per_template": 300,
      "dist_config": {
        "census_original.age": { "distribution": "uniform", "min": 18, "max": 75 }
      },
      "outputs": [
        { "type": "workload", "path": "./output/workload/trace_census_original_sqls.csv" }
      ]
    }
  ]
}
