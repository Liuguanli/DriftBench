# Optional explicit service-principal mode for the ADLS Gen2 cache.
# Prefer `az login`, managed identity, or workload identity whenever possible.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-a-private-local-value
